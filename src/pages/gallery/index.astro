---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagFilter from '../../components/TagFilter.astro';

const [images, projects, sims] = await Promise.all([
	getCollection('gallery'),
	getCollection('projects'),
	getCollection('simulations'),
]);

// Resolve each image's references into a title, link and merged tag list.
const items = images.map(({ id, data }) => {
	const project = projects.find((p) => p.id === data.project?.id);
	const sim = sims.find((s) => s.id === data.simulation?.id);
	const parent = project ?? sim;
	const link = project
		? `/projects/${project.id}`
		: sim
			? `/simulations/${sim.data.path ?? sim.id}/`
			: undefined;
	const tags = [...new Set([...(parent?.data.tags ?? []), ...data.tags])];
	return {
		id,
		src: data.src,
		caption: data.caption,
		title: parent?.data.title,
		link,
		tags,
		alt: data.caption || parent?.data.title || '',
	};
});
const tags = [...new Set(items.flatMap((i) => i.tags))].sort();
---

<Base title="Gallery — Greg McDonnell">
	<div class="page-header">
		<p class="page-label">Visuals</p>
		<h1>Gallery</h1>
		<p>
			Plots, renders, and visualizations from across projects. Click any image to enlarge and link
			to the source project.
		</p>
	</div>

	<main>
		<TagFilter tags={tags} />
		<div class="gallery-grid">
			{
				items.map((item) => (
					<div class="gallery-item" data-tags={item.tags.join(',')}>
						<button
							type="button"
							class="gallery-open"
							data-src={item.src}
							data-alt={item.alt}
							data-caption={item.caption}
							data-title={item.title}
							data-link={item.link}
							aria-label={`Enlarge: ${item.alt || item.id}`}
						>
							<img src={item.src} alt={item.alt} loading="lazy" />
						</button>
						<div class="gallery-overlay">
							{item.caption && <span class="overlay-caption">{item.caption}</span>}
							{item.title && item.link && (
								<a class="overlay-project" href={item.link}>
									↗ {item.title}
								</a>
							)}
						</div>
					</div>
				))
			}
		</div>
		<p class="loading-msg" id="no-match" hidden>No images match this filter.</p>
	</main>

	<dialog class="lightbox" id="lightbox" aria-label="Image viewer">
		<form method="dialog">
			<button class="lightbox-close">✕ close</button>
		</form>
		<img id="lightbox-img" alt="" />
		<p class="lightbox-caption" id="lightbox-caption"></p>
		<a class="lightbox-project-link" id="lightbox-link" href="/"></a>
	</dialog>
</Base>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		margin-top: 1.5rem;
	}

	.gallery-item {
		background: var(--bg);
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		transition: background 0.15s ease;
	}

	.gallery-item:hover {
		background: var(--surface);
	}

	.gallery-open {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.gallery-open img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Hover overlay. Clicks pass through to the button underneath, except on the link. */
	.gallery-overlay {
		position: absolute;
		inset: 0;
		background: rgba(26, 25, 23, 0.82);
		opacity: 0;
		transition: opacity 0.18s ease;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0.85rem;
		gap: 0.3rem;
		pointer-events: none;
	}

	.gallery-item:hover .gallery-overlay,
	.gallery-item:focus-within .gallery-overlay {
		opacity: 1;
	}

	.overlay-caption {
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.9);
		font-weight: 300;
		line-height: 1.4;
	}

	.overlay-project {
		font-family: var(--mono);
		font-size: 0.62rem;
		color: rgba(255, 255, 255, 0.5);
		letter-spacing: 0.06em;
		text-decoration: none;
		pointer-events: auto;
	}

	.overlay-project:hover {
		color: rgba(255, 255, 255, 0.85);
	}

	/* ── Lightbox (native <dialog>: Esc to close and focus trapping come for free) ── */
	.lightbox {
		border: 0;
		padding: 2rem;
		margin: 0;
		max-width: none;
		max-height: none;
		width: 100vw;
		height: 100vh;
		background: transparent;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 1rem;
	}

	.lightbox[open] {
		display: flex;
	}

	.lightbox::backdrop {
		background: rgba(26, 25, 23, 0.92);
	}

	.lightbox img {
		max-width: 90vw;
		max-height: 75vh;
		object-fit: contain;
		border-radius: 2px;
	}

	.lightbox-caption {
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.7);
		font-weight: 300;
		text-align: center;
	}

	.lightbox-project-link {
		font-family: var(--mono);
		font-size: 0.7rem;
		color: rgb(182, 182, 182);
		text-decoration: none;
		letter-spacing: 0.06em;
	}

	.lightbox-project-link:hover {
		color: rgb(224, 224, 224);
	}

	.lightbox-close {
		position: fixed;
		top: 1.2rem;
		right: 1.5rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.5);
		background: none;
		border: none;
		cursor: pointer;
		letter-spacing: 0.08em;
	}

	.lightbox-close:hover {
		color: #fff;
	}

	/* Stop the page scrolling behind the open lightbox. */
	:global(body:has(dialog[open])) {
		overflow: hidden;
	}
</style>

<script>
	const dialog = document.getElementById('lightbox') as HTMLDialogElement;
	const img = document.getElementById('lightbox-img') as HTMLImageElement;
	const caption = document.getElementById('lightbox-caption')!;
	const link = document.getElementById('lightbox-link') as HTMLAnchorElement;

	document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach((button) => {
		button.addEventListener('click', () => {
			const { src, alt, caption: text, title, link: href } = button.dataset;
			img.src = src!;
			img.alt = alt ?? '';
			caption.textContent = text ?? '';
			link.hidden = !href;
			if (href) {
				link.href = href;
				link.textContent = `→ View: ${title}`;
			}
			dialog.showModal();
		});
	});

	// Clicking the dim area around the content (the dialog itself) closes it.
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});
</script>
