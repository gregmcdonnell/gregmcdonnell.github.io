---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SimCard from '../../components/SimCard.astro';
import TagFilter from '../../components/TagFilter.astro';

// Newest first, without drafts.
const sims = (await getCollection('simulations', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const tags = [...new Set(sims.flatMap((s) => s.data.tags))].sort();
---

<Base title="Simulations — Greg McDonnell">
	<div class="page-header">
		<p class="page-label">Catalogue</p>
		<h1>Simulations</h1>
		<p>All interactive simulations found on this site.</p>
	</div>

	<main>
		<TagFilter tags={tags} />
		<div class="project-list">
			{sims.map((sim, i) => <SimCard sim={sim} index={i} />)}
			<p class="loading-msg" id="no-match" hidden>No simulations match this filter.</p>
		</div>
	</main>
</Base>
