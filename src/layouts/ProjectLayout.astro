---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import 'katex/dist/katex.min.css';

interface Props {
	project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;
const { title, date, description, simulation, code } = project;
---

<Base title={`${title} — Greg McDonnell`} description={description}>
	<Fragment slot="head">
		{
			code && (
				<>
					<link
						href="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/themes/prism.min.css"
						rel="stylesheet"
					/>
					<script
						is:inline
						defer
						src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/components/prism-core.min.js"
					/>
					<script
						is:inline
						defer
						src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/plugins/autoloader/prism-autoloader.min.js"
					/>
				</>
			)
		}
	</Fragment>

	<main>
		<div class="hero">
			<div class="hero-meta">
				<span>{date.getUTCFullYear()}</span>
			</div>
			<h1>{title}</h1>
			{description && <p class="hero-sub">{description}</p>}
			{
				simulation && (
					<a href={`/simulations/${simulation}/`} class="sim-btn">
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<polygon points="5 3 19 12 5 21 5 3" />
						</svg>
						Open Interactive Simulation
					</a>
				)
			}
		</div>

		<article>
			<slot />
		</article>
	</main>
</Base>
